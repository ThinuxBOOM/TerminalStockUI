# Copy to .env for local dev
VITE_API_BASE_URL=http://localhost:8000
APP_ENV=development

# --- VITE_API_BASE_URL options (Vite embeds VITE_* vars at BUILD time) ---
# 1) Local dev (default):          VITE_API_BASE_URL=http://localhost:8000
# 2) Vercel monorepo serverless (frontend + api/ in one project):
#    leave VITE_API_BASE_URL UNSET or empty -> client uses same-origin
#    (relative URLs hit /api/* on the same Vercel deployment, no CORS).
# 3) Separate backend (frontend-only deploy):
#    VITE_API_BASE_URL=https://<your-backend-host>   (no trailing slash)
#    + on the backend host set CORS_ORIGINS (or FRONTEND_URL) to this
#    frontend's origin — see infra/oracle/README.md + backend.env.example.
#
# Vercel dashboard: Project -> Settings -> Environment Variables ->
# add VITE_API_BASE_URL (Production and Preview as needed), then Redeploy.
# Changing it later requires a rebuild to take effect.

# --- Backend keys (NOT embedded by Vite; live in infra/docker/.env.example) ---
# Vite only embeds VITE_* at build time. The backend reads these at runtime;
# they are listed here so `grep -r` for required keys finds them, but set the
# real values in infra/docker/.env (local/compose) or the hosting dashboard
# (Vercel/Render), never in a frontend .env that ships to the browser.
#   DATABASE_URL=postgresql+psycopg://onemarket:change-me@postgres:5432/onemarket
#   REDIS_URL=redis://redis:6379/0
#   SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
#   CRON_SECRET=
#   APP_ENV=development (above; production on hosted backends)
