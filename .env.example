# Copy to .env (never commit it). Values below are the production defaults
# for docker-compose.yml. Generate secrets with:  openssl rand -hex 32

# --- Required ---------------------------------------------------------------
# Public hostname Caddy serves (DNS A/AAAA record -> this server). Use :80 for
# a plain-HTTP LAN test without a domain.
DOMAIN=onemarket.example.com

APP_ENV=production
# Signs login tokens and encrypts stored AI provider keys. Rotating it logs
# everyone out and makes stored provider keys unreadable (re-enter them).
SECRET_KEY=
# Bearer secret the scheduler container sends to /api/cron/*.
CRON_SECRET=

# Supabase Postgres. Use the SESSION pooler (port 5432) or the direct
# connection; the transaction pooler (6543) works but disables prepared
# statements. Example:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Accounts -----------------------------------------------------------------
# Self-service sign-up. Leave false and create accounts with
#   docker compose exec backend python scripts/create_user.py <email>
ALLOW_REGISTRATION=false

# --- Limits -------------------------------------------------------------------
AI_DAILY_CALLS_PER_USER=50
RATE_LIMIT_PER_MIN=300
AUTH_RATE_LIMIT_PER_MIN=10
DB_POOL_SIZE=5

# --- AI providers (optional; the app works without them) -------------------
# Keys can also be entered by an admin in the web UI (stored encrypted).
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# --- Market data (optional; yfinance needs no key) -----------------------------
# Check each provider's terms before exposing their data to other people.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_FEED=iex
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
# Contact string sent to SEC EDGAR (their fair-access policy requires one).
STATEMENTS_CONTACT=
# Best-effort Investopedia premarket scrape (off by default).
INVESTOPEDIA_ENABLED=false
# Comma-separated overrides for the daily ingest universe (max 25).
INGEST_SYMBOLS=

# --- Alerts -------------------------------------------------------------------
# POST fired alerts to this URL (e.g. a Discord/Slack-compatible webhook).
ALERTS_WEBHOOK_URL=

# --- Retention overrides (days; defaults in backend/observability/retention.py)
# RETENTION_BARS_DAYS=1825
# RETENTION_AUDIT_DAYS=2555
