# PostgreSQL
POSTGRES_USER=onemarket
POSTGRES_PASSWORD=change-me
POSTGRES_DB=onemarket
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://onemarket:change-me@postgres:5432/onemarket

# Redis (cache, job queue, provider health, rate limiting)
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# App
APP_ENV=development
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
# CRON_SECRET guards GET/POST /api/cron/{ingest,calibrate,evaluate} (Bearer).
# Empty = open locally; set a long random value in staging/prod (Vercel Cron
# sends `Authorization: Bearer $CRON_SECRET`). Required by backend/api/cron.py.
CRON_SECRET=change-me-generate-with-openssl-rand-hex-32
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# AI provider keys — empty by default. App must run fully with AI disabled.
# Never commit real keys. Keys are encrypted at rest server-side, never exposed to the browser.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Workers (M8 hardening, spec Sec 2: Celery/RQ/Arq; in-memory by default, no hard Redis dep)
WORKER_CONCURRENCY=4
WORKER_USE_REDIS=

# Retention rules (M8 hardening, spec Milestone 0 + Sec 6; days)
RETENTION_TICKS_DAYS=90
RETENTION_BARS_DAYS=1825
RETENTION_FORECASTS_DAYS=1095
RETENTION_AUDIT_DAYS=2555
RETENTION_AI_TOKEN_LOGS_DAYS=365

# Backups (M8 hardening, spec Sec 6: backup/restore tests; S3 optional)
BACKUP_DIR=./backups
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=onemarket/backups
BACKUP_S3_REGION=
