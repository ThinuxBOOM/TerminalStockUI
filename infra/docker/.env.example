# PostgreSQL
POSTGRES_USER=onemarket
POSTGRES_PASSWORD=change-me
POSTGRES_DB=onemarket
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://onemarket:change-me@postgres:5432/onemarket

# Redis (cache, job queue, provider health, rate limiting)
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# App
APP_ENV=development
# Generate with: openssl rand -hex 32. The backend logs an ERROR at startup
# when this is missing/a placeholder (see backend/security/secrets.py).
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
# CRON_SECRET guards GET/POST /api/cron/{ingest,calibrate,evaluate} (Bearer).
# Empty = open locally; set a long random value in staging/prod (Vercel Cron
# sends `Authorization: Bearer $CRON_SECRET`). Required by backend/api/cron.py.
CRON_SECRET=change-me-generate-with-openssl-rand-hex-32
# API_KEY guards all /api/* routes except /health (Bearer or X-API-Key).
# Empty = open locally; set a long random value in staging/prod.
# Comma-separated list supported for rotation. See docs/SECURITY.md.
API_KEY=
# CORS allow-list (comma-separated exact origins). Defaults cover local Vite
# dev; production must list the real frontend origin(s) — never "*".
CORS_ORIGINS=
# Single-origin alias for CORS_ORIGINS (simpler for one frontend). Local-LAN
# example: frontend at http://192.168.1.10:5173 talking to a backend at
# http://192.168.1.20:8000  ->  FRONTEND_URL=http://192.168.1.10:5173
# (Compose default below keeps localhost working out of the box.)
FRONTEND_URL=
# Abuse guard: max /api requests per client IP per 60s (0 = disabled).
RATE_LIMIT_PER_MIN=300
# Max JSON body size in bytes (413 beyond this).
MAX_REQUEST_BYTES=1000000
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# AI provider keys — empty by default. App must run fully with AI disabled.
# Never commit real keys. Keys are encrypted at rest server-side, never exposed to the browser.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Market-data live chain (Milestone 0, opt-in, free-first).
# Alpaca: free real-time US (IEX feed). Empty = Alpaca degrades to flagged
# stubs; yfinance + Stooq still serve delayed data. Never commit real keys.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# ALPACA_FEED: iex (free default) or sip (paid Algo Trader Plus).
ALPACA_FEED=iex
# Stooq: free delayed gap-filler (US + Euronext). No key needed.
# Ingest universe override (comma-list, max 25, validated; default =
# DEFAULT_UNIVERSE in backend/market_data/ingest.py). Must match Vercel env
# or Render/Vercel run split-brain universes.
INGEST_SYMBOLS=
INGEST_BAR_CHAIN=
EXTRA_SYMBOLS=
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=

# Workers (M8 hardening, spec Sec 2: Celery/RQ/Arq; in-memory by default, no hard Redis dep)
WORKER_CONCURRENCY=4
WORKER_USE_REDIS=

# Retention rules (M8 hardening, spec Milestone 0 + Sec 6; days)
RETENTION_TICKS_DAYS=90
RETENTION_BARS_DAYS=1825
RETENTION_FORECASTS_DAYS=1095
RETENTION_AUDIT_DAYS=2555
RETENTION_AI_TOKEN_LOGS_DAYS=365

# Backups (M8 hardening, spec Sec 6: backup/restore tests; S3 optional)
BACKUP_DIR=./backups
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=onemarket/backups
BACKUP_S3_REGION=

# V2 auth + billing (Phase 0: no behavior change; empty = unset, never real secrets).
# ADMIN_PASSWORD_HASH is a bcrypt string generated offline:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'<password>', bcrypt.gensalt()).decode())"
# FRONTEND_URL above is reused for Stripe success/cancel URLs — do not duplicate it here.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SILVER=
STRIPE_PRICE_GOLD=
STRIPE_PRICE_PLATINUM=
