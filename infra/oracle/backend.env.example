# Oracle Cloud backend env — copy to `backend.env` (same folder) and fill in.
# This file is NEVER committed with real secrets (gitignored via *.env).
# Local dev and Vercel are untouched by this file.

# --- Database: SAME Supabase project the Vercel backend uses today ---
# Use the pooled :6543 URL (Transaction mode) from Supabase Dashboard ->
# Project Settings -> Database -> Connection string -> "Transaction pooler".
# The backend detects :6543 and stays pgbouncer-safe automatically.
DATABASE_URL=postgresql://postgres.<REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres

# --- Connection pooling: long-lived host (NOT serverless) ---
# `queue` reuses connections in the persistent uvicorn process. Do NOT use
# `auto` here: APP_ENV=production would force NullPool (open-per-request),
# which is correct on Vercel but wasteful on a VM.
DB_POOL_MODE=queue

# --- Cache: SAME Upstash Redis the Vercel backend uses today ---
# YES, point Oracle at the existing Upstash instance — see infra/oracle/README.md.
# Preferred variable first; REDIS_URL is the fallback. Either may use rediss://.
UPSTASH_REDIS_URL=rediss://default:<PASSWORD>@<HOST>.upstash.io:6379
REDIS_URL=

# --- Auth / environment ---
APP_ENV=production
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
# MUST match the CRON_SECRET currently in Vercel env + GitHub secrets
# (workflows keep working after you repoint APP_URL at Oracle).
CRON_SECRET=

# --- CORS: the browser origin is your Vercel frontend ---
# Pick ONE style. Exact origin, https, no trailing slash, never "*".
# (Legacy Vercel monorepo needed none of this — same-origin has no CORS.)
CORS_ORIGINS=https://<your-app>.vercel.app
FRONTEND_URL=

# --- Universe / ingest overrides (optional, same semantics as Vercel) ---
INGEST_SYMBOLS=
INGEST_BAR_CHAIN=
EXTRA_SYMBOLS=

# --- Market-data provider keys (copy the values already in Vercel env) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=

# --- AI provider keys (optional; AI stays disabled when all are empty) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
